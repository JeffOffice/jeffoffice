Windows (MinGW): faiss uses bzero, which MinGW does not have; the MSVC stand-in (memset) is used there too.

--- a/3rd_party/marian-dev/src/3rd_party/faiss/utils/hamming-inl.h
+++ b/3rd_party/marian-dev/src/3rd_party/faiss/utils/hamming-inl.h
@@ -10,8 +10,9 @@
 namespace faiss {
 
 
-#ifdef _MSC_VER
-#define bzero(p,n) (memset((p),0,(n)))
+#if defined(_MSC_VER) || defined(__MINGW32__)
+#include <cstring>
+#define bzero(p,n) (memset((p),0,(n)))
 #endif
 inline BitstringWriter::BitstringWriter(uint8_t *code, int code_size):
     code (code), code_size (code_size), i(0)
