All systems: sentencepiece's trainer made a constant of -1 in an enum with no -1 (unicode_script::ScriptType), as constexpr. Apple's clang 21 refuses it
("constexpr variable 'kAnyType' must be initialized by a constant expression"; newer clang makes this an error, older ones a warning). A plain const holds the same value.

--- a/3rd_party/marian-dev/src/3rd_party/sentencepiece/src/trainer_interface.cc
+++ b/3rd_party/marian-dev/src/3rd_party/sentencepiece/src/trainer_interface.cc
@@ -208,7 +208,7 @@
     return false;
   }
 
-  constexpr unicode_script::ScriptType kAnyType =
+  const unicode_script::ScriptType kAnyType =
       static_cast<unicode_script::ScriptType>(-1);
 
   auto is_number = [](char32 c) { return (c >= 0x30 && c <= 0x39); };
