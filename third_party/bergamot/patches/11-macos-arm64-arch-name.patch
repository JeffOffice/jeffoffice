macOS: Marian's processor detection (cmake/TargetArch.cmake) takes CMAKE_OSX_ARCHITECTURES when it is set, and knew only the Intel names, so a build for arm64 stopped with "Invalid OS X arch name: arm64". It now knows arm64 (named arm64, which Marian's later checks for "arm" match). The engine is built once for each processor on a Mac, each with its own single name, and the archives are joined with lipo (cmake/bergamot.cmake).

diff --git a/3rd_party/marian-dev/cmake/TargetArch.cmake b/3rd_party/marian-dev/cmake/TargetArch.cmake
index f653e3e..32bbf04 100644
--- a/3rd_party/marian-dev/cmake/TargetArch.cmake
+++ b/3rd_party/marian-dev/cmake/TargetArch.cmake
@@ -79,6 +79,8 @@ function(target_architecture output_var)
                 set(osx_arch_i386 TRUE)
             elseif("${osx_arch}" STREQUAL "x86_64")
                 set(osx_arch_x86_64 TRUE)
+            elseif("${osx_arch}" STREQUAL "arm64")
+                set(osx_arch_arm64 TRUE)
             elseif("${osx_arch}" STREQUAL "ppc64" AND ppc_support)
                 set(osx_arch_ppc64 TRUE)
             else()
@@ -102,6 +104,10 @@ function(target_architecture output_var)
         if(osx_arch_ppc64)
             list(APPEND ARCH ppc64)
         endif()
+
+        if(osx_arch_arm64)
+            list(APPEND ARCH arm64)
+        endif()
     else()
         file(WRITE "${CMAKE_BINARY_DIR}/arch.c" "${archdetect_c_code}")
 
