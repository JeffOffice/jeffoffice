# Writes data.stamp and manifest.txt of the build's data folder (run by the jeffoffice_data target on every build; a file is
# rewritten only when its content changes). Arguments: HELP_SRC, DATA, VERSION.
#   data.stamp    the version: the mark that makes a folder the programs' data folder
#   manifest.txt  one path a line, relative to the folder: every Help file ("help/en/printing.md") and translation ("i18n/jeffoffice_de.qm")
function(jo_write_if_changed path content)
  set(old "")
  if(EXISTS ${path})
    file(READ ${path} old)
  endif()
  if(NOT old STREQUAL content)
    file(WRITE ${path} "${content}")
  endif()
endfunction()
file(GLOB_RECURSE help_files RELATIVE ${HELP_SRC} ${HELP_SRC}/*)
file(GLOB i18n_files RELATIVE ${DATA} ${DATA}/i18n/*.qm)
set(lines)
foreach(f ${help_files})
  list(APPEND lines "help/${f}")
endforeach()
list(APPEND lines ${i18n_files})
list(SORT lines)
list(JOIN lines "\n" text)
jo_write_if_changed(${DATA}/manifest.txt "${text}\n")
jo_write_if_changed(${DATA}/data.stamp "${VERSION}\n")
