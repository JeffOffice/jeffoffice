# The steps of the translation engine's build (cmake/bergamot.cmake runs this script at build time, never when CMake configures: a job that only configures, to
# check the docs or the style, fetches nothing). Run as
#   cmake -DJO_MODE=configure|build -DJO_ROOT=<repository> -DJO_BUILD=<build folder> -DJO_BIN=<the engine's build folder> -DJO_OVERRIDE=<a tree, or empty>
#         -DJO_GENERATOR=<generator> -DJO_ARGS=<arguments for the engine's configure, separated by |> -P cmake/bergamot_step.cmake
#         (a Mac also: -DJO_MAC_ARCHS=<processors, separated by |> -DJO_OUT=<folder of the joined archives> -DJO_LIBS=<their paths, separated by |> -DJO_CC=<C compiler>)
# Both modes first make the source tree (a stamp makes that no work when it is there); then `configure` configures the engine's project, and `build` builds it.
#
# The source: the commit below of https://github.com/browsermt/bergamot-translator and the parts of it the build needs (its sentence splitter, and Marian with
# intgemm, ruy, SentencePiece, and simd_utils, which come as git submodules). The commit names every one of them (a commit's name is a hash of everything under
# it); PCRE2, which the sentence splitter would download on its own (patch 10 stops that), is a release tarball checked against a hash of what is in it. The tree is
# copied to the build folder without its history, and the patches in third_party/bergamot/patches are applied to the copy: what each does is written at the top of
# its file. JO_OVERRIDE names a tree that is the same (the commit with those submodules, and PCRE2's folder in the splitter's 3rd-party folder), for a build that must
# not download; the patches are applied to a copy of it just the same.
set(ENV{CMAKE_POLICY_VERSION_MINIMUM} 3.5)

set(JO_BERGAMOT_COMMIT 9271618ebbdc5d21ac4dc4df9e72beb7ce644774)   # (its Marian is 2781d735d4a10dca876d61be587afdab2726293c)
set(JO_BERGAMOT_GIT https://github.com/browsermt/bergamot-translator.git)
# What the build needs of the submodules (the rest are for GPUs, a web server, Python, and tests); each is a path below the folder named before it.
set(JO_BERGAMOT_MARIAN_SUBMODULES src/3rd_party/intgemm src/3rd_party/ruy src/3rd_party/sentencepiece src/3rd_party/simd_utils)
set(JO_PCRE2_VERSION 10.39)
set(JO_PCRE2_URL https://github.com/PhilipHazel/pcre2/releases/download/pcre2-${JO_PCRE2_VERSION}/pcre2-${JO_PCRE2_VERSION}.tar.gz)
# (the SHA-256 of every file's name and its SHA-256, in order of name, over the unpacked tarball: the tarball's own bytes depend on the compressor)
set(JO_PCRE2_TREE_SHA256 bd25056b41df23eca3d9e307d6012b91d787e9526df746e905872e06bb94d10c)

find_program(JO_GIT git REQUIRED)

function(jo_tree_sha256 dir out)
  file(GLOB_RECURSE _files RELATIVE ${dir} LIST_DIRECTORIES false ${dir}/*)
  list(SORT _files)
  set(_all "")
  foreach(f IN LISTS _files)
    file(SHA256 ${dir}/${f} _h)
    string(APPEND _all "${f} ${_h}\n")
  endforeach()
  string(SHA256 _t "${_all}")
  set(${out} ${_t} PARENT_SCOPE)
endfunction()

function(jo_git dir)
  execute_process(COMMAND ${JO_GIT} ${ARGN} WORKING_DIRECTORY ${dir} RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "git ${ARGN} in ${dir} failed (${_rc}): ${_err}")
  endif()
  set(JO_GIT_OUTPUT "${_out}" PARENT_SCOPE)
endfunction()

# The commit and its submodules, in <build>/_deps/bergamot-raw (kept: a change to a patch does not fetch again).
function(jo_bergamot_clone raw)
  if(EXISTS ${raw}/.jo-commit)
    file(READ ${raw}/.jo-commit _have)
    string(STRIP "${_have}" _have)
    if(_have STREQUAL "${JO_BERGAMOT_COMMIT}")
      return()
    endif()
  endif()
  file(REMOVE_RECURSE ${raw})
  file(MAKE_DIRECTORY ${raw})
  jo_git(${raw} init -q)
  jo_git(${raw} remote add origin ${JO_BERGAMOT_GIT})
  jo_git(${raw} fetch -q --depth 1 origin ${JO_BERGAMOT_COMMIT})
  jo_git(${raw} checkout -q FETCH_HEAD)
  jo_git(${raw} rev-parse HEAD)
  string(STRIP "${JO_GIT_OUTPUT}" _head)
  if(NOT _head STREQUAL "${JO_BERGAMOT_COMMIT}")
    message(FATAL_ERROR "bergamot-translator: fetched ${_head}, expected ${JO_BERGAMOT_COMMIT}")
  endif()
  jo_git(${raw} submodule update --init --depth 1 -- 3rd_party/marian-dev 3rd_party/ssplit-cpp)
  jo_git(${raw}/3rd_party/marian-dev submodule update --init --depth 1 -- ${JO_BERGAMOT_MARIAN_SUBMODULES})
  jo_git(${raw}/3rd_party/marian-dev/src/3rd_party/ruy submodule update --init --depth 1 -- third_party/cpuinfo)
  file(WRITE ${raw}/.jo-commit "${JO_BERGAMOT_COMMIT}\n")
endfunction()

# Sets JO_BERGAMOT_SOURCE to the patched tree.
function(jo_bergamot_source)
  set(_dir ${JO_BUILD}/_deps/bergamot-src)
  file(GLOB _patches ${JO_ROOT}/third_party/bergamot/patches/*.patch)
  list(SORT _patches)
  set(_want "${JO_BERGAMOT_COMMIT} ${JO_PCRE2_TREE_SHA256} ${JO_OVERRIDE}\n")
  foreach(p IN LISTS _patches)
    file(READ ${p} _c)
    string(APPEND _want "${_c}")
  endforeach()
  string(SHA256 _want "${_want}")
  set(_have "")
  if(EXISTS ${_dir}/.jo-stamp AND EXISTS ${_dir}/CMakeLists.txt)
    file(READ ${_dir}/.jo-stamp _have)
    string(STRIP "${_have}" _have)
  endif()
  if(NOT _have STREQUAL _want)
    if(JO_OVERRIDE)
      set(_origin ${JO_OVERRIDE})
    else()
      set(_origin ${JO_BUILD}/_deps/bergamot-raw)
      jo_bergamot_clone(${_origin})
    endif()
    message(STATUS "bergamot-translator: preparing the source tree")
    file(REMOVE_RECURSE ${_dir})
    file(COPY ${_origin}/ DESTINATION ${_dir} PATTERN ".git" EXCLUDE)
    # PCRE2, where the sentence splitter looks for it (patch 10 makes it an error, not a download, when it is not there).
    set(_pcre ${_dir}/3rd_party/ssplit-cpp/src/3rd-party/pcre2-${JO_PCRE2_VERSION})
    if(NOT EXISTS ${_pcre}/CMakeLists.txt)
      set(_archive ${JO_BUILD}/_deps/pcre2-${JO_PCRE2_VERSION}.tar.gz)
      set(_code 1)
      foreach(_round RANGE 1 2)
        file(DOWNLOAD ${JO_PCRE2_URL} ${_archive} TLS_VERIFY ON TIMEOUT 300 INACTIVITY_TIMEOUT 60 STATUS _status)
        list(GET _status 0 _code)
        if(_code EQUAL 0)
          break()
        endif()
        message(STATUS "Downloading PCRE2, round ${_round} of 2, failed: ${_status}")
      endforeach()
      if(NOT _code EQUAL 0)
        message(FATAL_ERROR "Downloading PCRE2 failed: ${_status}")
      endif()
      file(REMOVE_RECURSE ${_pcre} ${_pcre}-unpack)
      file(ARCHIVE_EXTRACT INPUT ${_archive} DESTINATION ${_pcre}-unpack)
      file(RENAME ${_pcre}-unpack/pcre2-${JO_PCRE2_VERSION} ${_pcre})
      file(REMOVE_RECURSE ${_pcre}-unpack)
      file(REMOVE ${_archive})
    endif()
    jo_tree_sha256(${_pcre} _got)
    if(NOT _got STREQUAL "${JO_PCRE2_TREE_SHA256}")
      file(REMOVE_RECURSE ${_dir})
      message(FATAL_ERROR "PCRE2 ${JO_PCRE2_VERSION}: its files hash to ${_got}, expected ${JO_PCRE2_TREE_SHA256}")
    endif()
    # (git is kept from finding the program's own repository round the build folder: inside it, git apply leaves out, without an error, a file it takes
    # for one outside its reach, and a Mac build went on without patch 11 (Nov 14); each patch is then checked to be in, by applying it backward)
    foreach(p IN LISTS _patches)
      execute_process(COMMAND ${CMAKE_COMMAND} -E env GIT_CEILING_DIRECTORIES=${JO_BUILD}/_deps ${JO_GIT} apply --ignore-whitespace ${p}
        WORKING_DIRECTORY ${_dir} RESULT_VARIABLE _rc ERROR_VARIABLE _err)
      if(_rc EQUAL 0)
        execute_process(COMMAND ${CMAKE_COMMAND} -E env GIT_CEILING_DIRECTORIES=${JO_BUILD}/_deps ${JO_GIT} apply --ignore-whitespace --check --reverse ${p}
          WORKING_DIRECTORY ${_dir} RESULT_VARIABLE _rc ERROR_VARIABLE _err)
      endif()
      if(NOT _rc EQUAL 0)
        file(REMOVE_RECURSE ${_dir})
        message(FATAL_ERROR "bergamot-translator: the patch ${p} does not apply: ${_err}")
      endif()
    endforeach()
    file(WRITE ${_dir}/.jo-stamp "${_want}\n")
  endif()
  set(JO_BERGAMOT_SOURCE ${_dir} PARENT_SCOPE)
endfunction()

jo_bergamot_source()
string(REPLACE "|" ";" _args "${JO_ARGS}")

# A Mac: one engine build for each processor (JO_MAC_ARCHS, separated by |), each in <JO_BIN>/<processor> with a single CMAKE_OSX_ARCHITECTURES (what puts -arch on
# its compiles, and what Marian's detection reads: patch 11 teaches it arm64), the processor named to the engine (ruy chooses its kernels by it), and its own
# processor level. The archives of all of them are joined by lipo, to the same names below JO_OUT. Intgemm is Intel's alone: the other processor's slice of its
# archive is an empty one.
if(JO_MAC_ARCHS)
  string(REPLACE "|" ";" _archs "${JO_MAC_ARCHS}")
  foreach(_arch IN LISTS _archs)
    if(_arch STREQUAL "arm64")
      set(_level armv8-a)
    else()
      set(_level x86-64-v2)
    endif()
    set(_bin ${JO_BIN}/${_arch})
    if(JO_MODE STREQUAL "configure")
      message(STATUS "Translation engine: configuring ${_arch} (processor level ${_level}) in ${_bin}")
      execute_process(COMMAND ${CMAKE_COMMAND} -S ${JO_ROOT}/third_party/bergamot -B ${_bin} -G ${JO_GENERATOR} ${_args} -DCMAKE_OSX_ARCHITECTURES=${_arch}
                      -DCMAKE_SYSTEM_PROCESSOR=${_arch} -DJO_BERGAMOT_ARCH=${_level} -DJO_BERGAMOT_SOURCE=${JO_BERGAMOT_SOURCE} RESULT_VARIABLE _rc)
    elseif(JO_MODE STREQUAL "build")
      message(STATUS "Translation engine: building ${_arch}")
      execute_process(COMMAND ${CMAKE_COMMAND} --build ${_bin} --target jo_translate_engine RESULT_VARIABLE _rc)
    else()
      message(FATAL_ERROR "JO_MODE is configure or build")
    endif()
    if(NOT _rc EQUAL 0)
      message(FATAL_ERROR "the translation engine's ${JO_MODE} for ${_arch} failed (${_rc})")
    endif()
  endforeach()
  if(JO_MODE STREQUAL "build")
    string(REPLACE "|" ";" _libs "${JO_LIBS}")
    foreach(_lib IN LISTS _libs)
      file(RELATIVE_PATH _rel ${JO_OUT} ${_lib})
      set(_in "")
      foreach(_arch IN LISTS _archs)
        if(EXISTS ${JO_BIN}/${_arch}/${_rel})
          list(APPEND _in ${JO_BIN}/${_arch}/${_rel})
        elseif(_rel MATCHES "intgemm")
          set(_stub ${JO_BIN}/${_arch}-empty.a)
          if(NOT EXISTS ${_stub})
            file(WRITE ${JO_BIN}/${_arch}-empty.c "typedef int jo_empty_archive;\n")
            execute_process(COMMAND ${JO_CC} -arch ${_arch} -c ${JO_BIN}/${_arch}-empty.c -o ${JO_BIN}/${_arch}-empty.o RESULT_VARIABLE _rc)
            if(_rc EQUAL 0)
              execute_process(COMMAND libtool -static -o ${_stub} ${JO_BIN}/${_arch}-empty.o RESULT_VARIABLE _rc)
            endif()
            if(NOT _rc EQUAL 0)
              message(FATAL_ERROR "the translation engine: an empty archive for ${_arch} failed (${_rc})")
            endif()
          endif()
          list(APPEND _in ${_stub})
        else()
          message(FATAL_ERROR "the translation engine: ${JO_BIN}/${_arch}/${_rel} was not built")
        endif()
      endforeach()
      # (joined again only when an input is newer; the build runs this at every build)
      set(_redo FALSE)
      if(NOT EXISTS ${_lib})
        set(_redo TRUE)
      else()
        foreach(_i IN LISTS _in)
          if("${_i}" IS_NEWER_THAN "${_lib}")
            set(_redo TRUE)
          endif()
        endforeach()
      endif()
      if(_redo)
        get_filename_component(_dir ${_lib} DIRECTORY)
        file(MAKE_DIRECTORY ${_dir})
        execute_process(COMMAND lipo -create ${_in} -output ${_lib} RESULT_VARIABLE _rc ERROR_VARIABLE _err)
        if(NOT _rc EQUAL 0)
          message(FATAL_ERROR "lipo -create for ${_rel} failed (${_rc}): ${_err}")
        endif()
      endif()
    endforeach()
  endif()
  return()
endif()

if(JO_MODE STREQUAL "configure")
  execute_process(COMMAND ${CMAKE_COMMAND} -S ${JO_ROOT}/third_party/bergamot -B ${JO_BIN} -G ${JO_GENERATOR} ${_args} -DJO_BERGAMOT_SOURCE=${JO_BERGAMOT_SOURCE}
                  RESULT_VARIABLE _rc)
elseif(JO_MODE STREQUAL "build")
  execute_process(COMMAND ${CMAKE_COMMAND} --build ${JO_BIN} --target jo_translate_engine RESULT_VARIABLE _rc)
else()
  message(FATAL_ERROR "JO_MODE is configure or build")
endif()
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "the translation engine's ${JO_MODE} failed (${_rc})")
endif()
