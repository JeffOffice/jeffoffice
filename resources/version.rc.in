// Windows version resource, configured by CMake (jo_add_version_info). It is what the
// file's Properties > Details tab shows. The copyright sign is written as an octal escape
// so the file stays plain ASCII for windres.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @JO_RC_VERSION@
 PRODUCTVERSION @JO_RC_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "JeffOffice LLC"
            VALUE "FileDescription", "@JO_RC_DESCRIPTION@"
            VALUE "FileVersion", "@JO_RC_VERSION_TEXT@"
            VALUE "InternalName", "@JO_RC_NAME@"
            VALUE "LegalCopyright", "\251 2026 JeffOffice LLC"
            VALUE "OriginalFilename", "@JO_RC_NAME@.exe"
            VALUE "ProductName", "JeffOffice"
            VALUE "ProductVersion", "@JO_RC_VERSION_TEXT@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
