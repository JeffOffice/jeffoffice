<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key>
    <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundleName</key>
    <string>JeffDeck</string>
    <key>CFBundleDisplayName</key>
    <string>JeffDeck</string>
    <key>CFBundleIconFile</key>
    <string>${MACOSX_BUNDLE_ICON_FILE}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 JeffOffice LLC. Free software under the GNU General Public License v3.0.</string>
    <!-- The presentation formats JeffDeck opens; it is listed under Open With
         and never made their default. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Presentation (.pptx)</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.openxmlformats.presentationml.presentation</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>pptx</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Presentation template (.potx)</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.openxmlformats.presentationml.template</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>potx</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Slide show (.ppsx)</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.openxmlformats.presentationml.slideshow</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>ppsx</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Presentation (.ppt)</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.microsoft.powerpoint.ppt</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>ppt</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>OpenDocument presentation (.odp)</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.oasis-open.opendocument.presentation</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>odp</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>OpenDocument presentation template (.otp)</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.oasis-open.opendocument.presentation-template</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>otp</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
