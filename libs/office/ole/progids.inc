// The standard program IDs of embedded objects, the one place they are written (Jeff, Nov 18). Never shown on screen or in Help.
// JO_OLE_KIND(kind, program ID, extension of the package an object of that kind is saved as)
// JO_OLE_ALIAS(kind, the same program's ID without a version, which other programs write)
JO_OLE_KIND(Sheet, "Excel.Sheet.12", "xlsx")
JO_OLE_ALIAS(Sheet, "Excel.Sheet")
JO_OLE_KIND(Page, "Word.Document.12", "docx")
JO_OLE_ALIAS(Page, "Word.Document")
